# ===== Intelli-Credit (CreditDNA) environment configuration =====

# ---- Application ----
APP_NAME=Intelli-Credit
APP_ENV=development
DEBUG=true
MODEL_VERSION=1.0.0

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 32-byte (44 char base64) Fernet key. Leave blank to auto-generate at startup (dev only).
ENCRYPTION_KEY=

# ---- Database (defaults to local SQLite if DATABASE_URL unset) ----
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/intellicredit
DATABASE_URL=

# ---- Object storage (MinIO / S3) ----
STORAGE_BACKEND=local            # local | minio | s3
STORAGE_LOCAL_PATH=./_storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intelli-credit
MINIO_SECURE=false

# ---- Databricks / Delta Lake (optional) ----
DATABRICKS_ENABLED=false
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DELTA_FEATURE_STORE_PATH=./_delta_feature_store

# ---- External APIs ----
MCA21_API_URL=https://api.mca.gov.in
MCA21_API_KEY=
ECOURTS_API_URL=https://services.ecourts.gov.in
ECOURTS_API_KEY=

# ---- Research agent ----
RESEARCH_AGENT_ENABLED=true
RESEARCH_AGENT_TIMEOUT_SECONDS=120

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=100

# ---- Async job backend ----
# local = in-process thread pool (default); celery = distributed workers
JOB_BACKEND=local
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# REDIS_URL=redis://localhost:6379/0

# ---- Database migrations ----
# Run: alembic upgrade head   (uses DATABASE_URL, or the local SQLite fallback)
